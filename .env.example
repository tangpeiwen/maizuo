# Maizuo automation environment variables.
# Copy to .env locally if needed. Never commit real secrets.

# Feishu incoming webhook for text alerts.
FEISHU_WEBHOOK_URL=
FEISHU_BOT_SECRET=

# Feishu app credentials for sending Excel files to a group.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# Optional overrides.
MAIZUO_WORKSPACE_ROOT=/Users/aaaa/Documents/GitHub/maizuo
MAIZUO_OUTPUT_DIR=/Users/aaaa/Documents/GitHub/maizuo/outputs/maizuo
MAIZUO_PTNR_ID=20021
MAIZUO_ORG_ID_DEFAULT=20021
MAIZUO_CHROME_APP_PATH=/Applications/Google Chrome.app
